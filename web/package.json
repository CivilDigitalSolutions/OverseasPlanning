{
  "name": "overseas-planning-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json && vite build",
    "preview": "vite preview",
    "test": "node --test test/*.test.ts",
    "icons": "cd .. && python3 web/scripts/make-brand.py web/public/icons web/src/assets",
    "build:demo": "tsc --noEmit && vite build --config vite.demo.config.ts",
    "build:aws": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json && VITE_BACKEND=laravel vite build --outDir dist-aws",
    "dev:aws": "VITE_BACKEND=laravel vite",
    "build:pages": "npm run build:demo && node scripts/pages.mjs"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "firebase": "^12.19.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
