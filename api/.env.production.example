# Production settings for the API container. Values marked SECRET come from AWS Secrets Manager
# (injected by ECS), never from this file or git. TODO(owner) items follow docs/AWS-SECURITY.md.
APP_NAME="Voyager Trip Manager"
APP_ENV=production
APP_DEBUG=false
APP_KEY=                          # SECRET (php artisan key:generate --show). Rotate with APP_PREVIOUS_KEYS.
APP_URL=https://voyager.example.org   # TODO(owner): production domain
LOG_CHANNEL=stderr
SECURITY_LOG_PATH=php://stderr

DB_CONNECTION=pgsql
DB_HOST=                          # RDS endpoint (private subnet)
DB_PORT=5432
DB_DATABASE=voyager
DB_USERNAME=voyager_app
DB_PASSWORD=                      # SECRET
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_SECURE_COOKIE=true
SESSION_COOKIE=__Host-voyager-session
SESSION_SAME_SITE=lax
SESSION_IDLE_MINUTES=30           # TODO(owner)
SESSION_ABSOLUTE_HOURS=12         # TODO(owner)
SANCTUM_STATEFUL_DOMAINS=voyager.example.org
TRUSTED_PROXIES=10.0.0.0/16       # the load balancer's subnet only

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=smtp
MAIL_HOST=email-smtp.eu-west-2.amazonaws.com
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=                    # SECRET (SES SMTP credentials)
MAIL_PASSWORD=                    # SECRET
MAIL_FROM_ADDRESS=no-reply@voyager.example.org
MAIL_FROM_NAME="Voyager Trip Manager"

ATTACHMENTS_DISK=s3
ATTACHMENTS_BUCKET=               # private bucket, Block Public Access on
ATTACHMENTS_KMS_KEY_ID=           # KMS key for SSE-KMS
AWS_DEFAULT_REGION=eu-west-2
# No AWS keys here: the ECS task role grants s3:GetObject/PutObject/DeleteObject on that bucket only.

VAPID_SUBJECT=mailto:security@example.org
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=                # SECRET (php artisan voyager:vapid)

PASSKEY_RP_ID=voyager.example.org
PASSWORD_BREACH_CHECK=true        # needs api.pwnedpasswords.com through Zscaler, else fails open
SECURITY_RASP_MODE=detect         # switch to protect after the pilot
TERMS_VERSION=draft-0
PRIVACY_VERSION=draft-0
